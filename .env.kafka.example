# Local prototype defaults. Inside Docker, use a broker reachable from the backend container.
KAFKA_BROKER_URL=localhost:9092
KAFKA_TOPIC=ods.industria.defeito_classificado
KAFKA_GROUP_ID=VER-1-A1-Consumer
KAFKA_RETRY_ATTEMPTS=5
KAFKA_RETRY_INITIAL=0.25
KAFKA_RETRY_MAX=4.0
KAFKA_SHUTDOWN_TIMEOUT=15

# Endereços compartilhados informados pela equipe em 06/11/2026:
# Acesso externo: KAFKA_BROKER_URL=200.17.66.56:9093
# Serviços na Jetson: KAFKA_BROKER_URL=172.18.4.56:9092
# São opções explícitas de ambiente; disponibilidade e contrato exigem validação.
# A composição local de teste continua usando seu broker Kafka isolado.
