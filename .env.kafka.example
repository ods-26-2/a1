# Local prototype defaults. Inside Docker, use a broker reachable from the backend container.
KAFKA_BROKER_URL=localhost:9092
KAFKA_TOPIC=ods.industria.defeito_classificado
KAFKA_GROUP_ID=VER-1-A1-Consumer
KAFKA_RETRY_ATTEMPTS=5
KAFKA_RETRY_INITIAL=0.25
KAFKA_RETRY_MAX=4.0
KAFKA_SHUTDOWN_TIMEOUT=15

# B2 shared tests: set KAFKA_BROKER_URL=34.66.235.91:9093 explicitly.
