{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClipEvent",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.s4.clip"
    },
    "message_type": {
      "type": "string",
      "const": "event"
    },
    "producer": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "payload": {
      "type": "object",
      "properties": {
        "clip_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "media_type": {
          "type": "string",
          "enum": ["CLIP", "SNAPSHOT"]
        },
        "media_uri": {
          "type": "string"
        },
        "start_at": {
          "type": "string",
          "format": "date-time"
        },
        "end_at": {
          "type": "string",
          "format": "date-time"
        },
        "points_of_interest": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "at": {
                "type": "string",
                "format": "date-time"
              },
              "label": {
                "type": "string"
              }
            },
            "required": ["at", "label"]
          }
        },
        "hash_sha256": {
          "type": "string"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "clip_id",
        "media_type",
        "media_uri",
        "start_at",
        "end_at",
        "hash_sha256",
        "expires_at"
      ]
    }
  },
  "required": [
    "schema",
    "message_type",
    "producer",
    "source_id",
    "payload"
  ]
}
