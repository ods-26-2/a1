{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CaptureReply",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ods.s4.capture.reply"
    },
    "message_type": {
      "type": "string",
      "const": "reply"
    },
    "producer": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["OK", "ERROR"]
        },
        "clip_id": {
          "type": "string",
          "format": "uuid"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": ["SOURCE_NOT_FOUND", "OUT_OF_BUFFER", "DISK_FULL"]
            },
            "message": {
              "type": "string"
            }
          },
          "required": ["code", "message"]
        }
      },
      "required": ["status"],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "OK"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["clip_id"]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "ERROR"
              }
            },
            "required": ["status"]
          },
          "then": {
            "required": ["error"]
          }
        }
      ]
    }
  },
  "required": [
    "schema",
    "message_type",
    "producer",
    "correlation_id",
    "payload"
  ]
}
