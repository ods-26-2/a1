{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ods.local/a1/api/v1/report.schema.json",
  "type": "object",
  "oneOf": [
    {"required": ["report_version", "kind", "generated_at", "inspection", "history", "causes"], "additionalProperties": false,
     "properties": {
       "report_version": {"const": "1.0"}, "kind": {"const": "inspection"},
       "generated_at": {"type": "string", "format": "date-time"},
       "inspection": {"$ref": "inspection-view.schema.json"},
       "history": {"$ref": "inspection-history.schema.json"},
       "causes": {"type": "array", "maxItems": 5000, "items": {"$ref": "cause.schema.json"}}
     }},
    {"required": ["report_version", "kind", "generated_at", "filters", "total_inspections", "items"], "additionalProperties": false,
     "properties": {
       "report_version": {"const": "1.0"}, "kind": {"enum": ["recurrence", "causes"]},
       "generated_at": {"type": "string", "format": "date-time"},
       "filters": {"type": "object", "additionalProperties": false, "required": ["captured_from", "captured_to", "result", "source_id", "defect_class"],
          "properties": {"captured_from": {"type": "string", "format": "date-time"}, "captured_to": {"type": "string", "format": "date-time"},
            "result": {"enum": [null, "CONFORMING", "NON_CONFORMING", "ANOMALY", "UNCERTAIN"]}, "source_id": {"type": ["string", "null"]}, "defect_class": {"type": ["string", "null"]}}},
       "total_inspections": {"type": "integer", "minimum": 0, "maximum": 5000},
       "items": {"type": "array", "maxItems": 5000, "items": {"oneOf": [
          {"type": "object", "additionalProperties": false, "required": ["source_id", "taxonomy_version", "defect_class", "count", "rate", "recurring"],
            "properties": {"source_id": {"type": "string"}, "taxonomy_version": {"type": "string"}, "defect_class": {"type": "string"}, "count": {"type": "integer", "minimum": 1}, "rate": {"type": "number", "minimum": 0, "maximum": 1}, "recurring": {"type": "boolean"}}},
          {"type": "object", "additionalProperties": false, "required": ["cause", "status", "count"],
            "properties": {"cause": {"type": ["string", "null"]}, "status": {"enum": ["OPERATOR_REPORTED", "NOT_RECORDED"]}, "count": {"type": "integer", "minimum": 1}}}
       ]}}
     },
     "allOf": [
       {"if": {"properties": {"kind": {"const": "recurrence"}}}, "then": {"properties": {"items": {"items": {"required": ["recurring"]}}}}},
       {"if": {"properties": {"kind": {"const": "causes"}}}, "then": {"properties": {"items": {"items": {"required": ["status"]}}}}}
     ]}
  ]
}
